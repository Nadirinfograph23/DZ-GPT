{
  "installCommand": "npx --yes npm@9 ci --ignore-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "includeFiles": "bin/**,data/**,dialect/**,lib/**,modules/**"
    },
    "api/report-bug.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/report-bug",
      "destination": "/api/report-bug"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
